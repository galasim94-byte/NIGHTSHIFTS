<Window x:Class="Nightshift.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="NIGHTSHIFT"
        Width="424"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre : glisser pour déplacer, boutons dessinés. -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="N I G H T S H I F T" Margin="10,0,0,0" FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button Style="{StaticResource ChromeButton}" Content="–"
                        Click="Minimize_Click" ToolTip="Réduire" />
                <Button Style="{StaticResource ChromeButton}" Content="✕"
                        Click="Close_Click" ToolTip="Fermer et restaurer l'écran" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,2,24,22">

            <!-- État -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="18,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Filtre nocturne" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  ToolTip="Activer ou désactiver le filtre" />
                </Grid>
            </Border>

            <!-- Température -->
            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TemperatureText}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="62" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="K" FontSize="17" Margin="5,0,0,13" VerticalAlignment="Bottom"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Text="{Binding WarmthName}" HorizontalAlignment="Center" FontSize="10.5"
                           Margin="0,-4,0,0"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <Slider x:Name="TemperatureSlider" Style="{StaticResource NightSlider}"
                    Background="{StaticResource TemperatureTrackBrush}"
                    Minimum="1900" Maximum="6500"
                    SmallChange="50" LargeChange="250"
                    TickFrequency="50" IsSnapToTickEnabled="True"
                    Margin="0,20,0,0"
                    Value="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="2,4,2,0">
                <TextBlock Text="1 900 K" HorizontalAlignment="Left" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="6 500 K" HorizontalAlignment="Right" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,14,-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <primitives:UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource ChipToggle}"
                                      Content="{Binding Label}"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding Command}"
                                      Margin="0,0,6,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ce que l'écran affiche réellement (peut différer de la consigne) -->
            <TextBlock Text="{Binding EffectiveText}" Margin="0,16,0,0"
                       FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="10"
                    Background="#1AF2C97E" BorderBrush="#33F2C97E" BorderThickness="1"
                    Visibility="{Binding ShowStrengthNote, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StrengthNote}" FontSize="10.5" TextWrapping="Wrap"
                           LineHeight="15" Foreground="#E0C9A6" />
            </Border>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,18" />

            <!-- Luminosité -->
            <Grid>
                <TextBlock Text="Luminosité" FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding BrightnessText}" HorizontalAlignment="Right"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Grid>

            <Slider x:Name="BrightnessSlider" Style="{StaticResource NightSlider}"
                    Background="{StaticResource BrightnessTrackBrush}"
                    Minimum="5" Maximum="100"
                    SmallChange="1" LargeChange="10"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Margin="0,10,0,0"
                    Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding BrightnessHint}" FontSize="10" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />

            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="10"
                    Background="#1FFF8073" BorderBrush="#4DFF8073" BorderThickness="1"
                    Visibility="{Binding ShowHdrWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding HdrWarning}" FontSize="10.5" TextWrapping="Wrap"
                           LineHeight="15" Foreground="#FFC9C2" />
            </Border>

            <Grid Margin="0,18,0,0">
                <TextBlock Text="{Binding MonitorSummary}" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="{Binding EngineStatus}" FontSize="10" HorizontalAlignment="Right"
                           MaxWidth="250" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding EngineStatusBrush}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
